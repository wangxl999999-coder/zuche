<view class="rating">
  <view 
    wx:for="{{stars}}" 
    wx:key="index"
    class="star {{item.active ? 'active' : ''}}"
    style="font-size: {{item.fontSize}}; color: {{item.active ? color : voidColor}};"
    bindtap="selectStar"
    data-index="{{item.index}}"
  >
    ★
  </view>
  <text class="rating-value" wx:if="{{value}}">{{value}}分</text>
</view>
