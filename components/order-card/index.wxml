<view class="order-card" bindtap="goDetail">
  <view class="order-header">
    <text class="order-no">订单号：{{order.orderNo}}</text>
    <text class="order-status" style="color: {{statusMap[order.status].color}}">
      {{statusMap[order.status].label}}
    </text>
  </view>
  <view class="order-body">
    <image class="car-image" src="{{order.carImage}}" mode="aspectFill"></image>
    <view class="car-info">
      <view class="car-name">{{order.carName}}</view>
      <view class="car-specs">{{order.transmission}} · {{order.seats}}座 · {{order.fuelType}}</view>
      <view class="rental-time">
        <text>租期：{{order.rentalDays}}天</text>
      </view>
      <view class="rental-address">
        <text>取车：{{order.pickupAddress}}</text>
      </view>
    </view>
  </view>
  <view class="order-footer">
    <view class="total-amount">
      <text>实付</text>
      <text class="price">{{order.totalAmount}}</text>
    </view>
    <view class="order-actions">
      <block wx:if="{{order.status === 0}}">
        <button class="btn btn-outline btn-small">取消订单</button>
        <button class="btn btn-primary btn-small">去支付</button>
      </block>
      <block wx:elif="{{order.status === 4}}">
        <button class="btn btn-primary btn-small">一键开门</button>
      </block>
      <block wx:elif="{{order.status === 8}}">
        <button class="btn btn-primary btn-small">去评价</button>
      </block>
      <block wx:else>
        <button class="btn btn-outline btn-small">查看详情</button>
      </block>
    </view>
  </view>
</view>
