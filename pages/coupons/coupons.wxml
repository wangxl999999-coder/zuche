<view class="page">
  <view class="tabs">
    <view 
      class="tab-item {{activeTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="value"
      bindtap="switchTab"
      data-index="{{index}}"
    >
      {{item.label}}
    </view>
  </view>

  <view class="coupon-list">
    <view 
      class="coupon-item {{item.status !== 1 ? 'disabled' : ''}}"
      wx:for="{{filteredCoupons}}"
      wx:key="id"
      bindtap="useCoupon"
      data-id="{{item.id}}"
    >
      <view class="coupon-left">
        <view class="coupon-value">{{getCouponValue(item)}}</view>
        <view class="coupon-condition">满{{item.minAmount}}元可用</view>
      </view>
      <view class="coupon-right">
        <view class="coupon-name">{{item.name}}</view>
        <view class="coupon-desc">{{item.desc}}</view>
        <view class="coupon-expire">有效期至 {{item.expireTime}}</view>
      </view>
      <view class="coupon-status" wx:if="{{item.status !== 1}}">
        {{item.status === 2 ? '已使用' : '已过期'}}
      </view>
    </view>

    <view class="empty" wx:if="{{filteredCoupons.length === 0}}">
      <text class="empty-icon">🎫</text>
      <text class="empty-text">暂无优惠券</text>
    </view>
  </view>
</view>
