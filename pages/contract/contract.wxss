.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.contract-container {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.contract-header {
  padding: 40rpx;
  text-align: center;
  border-bottom: 2rpx dashed #eee;
}

.contract-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.contract-subtitle {
  font-size: 24rpx;
  color: #999;
}

.contract-content {
  padding: 30rpx;
}

.contract-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}

.section-content {
  display: flex;
  flex-direction: column;
}

.section-content text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.terms-content {
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 20rpx;
}

.terms-content text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}

.contract-footer {
  padding: 40rpx 30rpx;
  border-top: 1rpx solid #eee;
}

.agree-section {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 15rpx;
  font-size: 24rpx;
  color: #fff;
}

.checkbox.checked {
  background: #1989fa;
  border-color: #1989fa;
}

.agree-text {
  font-size: 26rpx;
  color: #666;
}

.link {
  font-size: 26rpx;
  color: #1989fa;
}

.sign-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.sign-btn::after {
  border: none;
}

.sign-btn.disabled {
  background: #ccc;
}
