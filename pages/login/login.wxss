.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1989fa 0%, #fff 50%);
}

.header {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
}

.content {
  padding: 60rpx 60rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 40rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 80rpx;
}

.login-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-choose-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.avatar-choose-btn::after {
  border: none;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.avatar-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.nickname-input-wrap {
  width: 100%;
  margin: 30rpx 0;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 16rpx;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: #333;
  text-align: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.nickname {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn::after {
  border: none;
}

.btn-outline {
  background: #fff;
  color: #1989fa;
  border: 2rpx solid #1989fa;
}

.btn-primary {
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
}

.phone-login {
  margin-top: 20rpx;
}

.login-tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.login-tip .link {
  color: #1989fa;
}

.features {
  margin-top: 60rpx;
  display: flex;
  justify-content: space-around;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #666;
}
