.page {
  padding-bottom: 140rpx;
  background: #f5f5f5;
}

.car-info {
  display: flex;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.car-image {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.car-detail {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.car-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.car-specs {
  font-size: 24rpx;
  color: #999;
}

.car-price {
  display: flex;
  align-items: baseline;
}

.car-price .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
}

.car-price .price::before {
  content: '¥';
  font-size: 24rpx;
}

.car-price .unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.date-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
}

.date-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.date-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.time-value {
  font-size: 26rpx;
  color: #1989fa;
}

.date-arrow {
  font-size: 40rpx;
  color: #ccc;
  padding: 0 20rpx;
}

.rental-days {
  text-align: center;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.method-tabs {
  display: flex;
  margin-bottom: 30rpx;
}

.method-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.method-tab.active {
  color: #1989fa;
  font-weight: 500;
  border-bottom-color: #1989fa;
}

.address-section {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
}

.address-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.address-item:last-child {
  border-bottom: none;
}

.address-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.address-value {
  font-size: 28rpx;
  color: #333;
}

.address-input {
  padding: 16rpx 0;
}

.input {
  height: 72rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.delivery-fee {
  font-size: 24rpx;
  color: #1989fa;
  margin-top: 16rpx;
}

.service-list {
  background: #f5f5f5;
  border-radius: 12rpx;
  overflow: hidden;
}

.service-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.service-item:last-child {
  border-bottom: none;
}

.service-item.selected {
  background: #e8f3ff;
}

.service-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.service-item.selected .service-checkbox {
  background: #1989fa;
  border-color: #1989fa;
  color: #fff;
  font-size: 24rpx;
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 24rpx;
  color: #999;
}

.service-price {
  display: flex;
  align-items: baseline;
}

.service-price .price {
  font-size: 32rpx;
  font-weight: 500;
  color: #ee0a24;
}

.service-price .price::before {
  content: '¥';
  font-size: 22rpx;
}

.service-price .unit {
  font-size: 22rpx;
  color: #999;
}

.coupon-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.coupon-text {
  font-size: 28rpx;
  color: #333;
}

.coupon-text .placeholder {
  color: #999;
}

.coupon-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.price-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: #f5f5f5;
  border-radius: 12rpx 12rpx 0 0;
}

.summary-left {
  display: flex;
  align-items: center;
}

.summary-label {
  font-size: 28rpx;
  color: #333;
}

.summary-arrow {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.summary-right {
  display: flex;
  align-items: baseline;
}

.summary-right .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
}

.summary-right .price::before {
  content: '¥';
  font-size: 24rpx;
}

.price-detail {
  background: #fafafa;
  border-radius: 0 0 12rpx 12rpx;
  padding: 0 30rpx 30rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #666;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
}

.detail-value.discount {
  color: #07c160;
}

.detail-total {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 0 10rpx;
}

.total-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.total-value {
  font-size: 28rpx;
  color: #ee0a24;
  font-weight: bold;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.bar-price {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 26rpx;
  color: #666;
}

.bar-price .price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ee0a24;
}

.bar-price .price::before {
  content: '¥';
  font-size: 26rpx;
}

.deposit-tip {
  font-size: 22rpx;
  color: #999;
  margin-left: 10rpx;
}

.submit-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.submit-btn::after {
  border: none;
}

.coupon-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.coupon-mask.show {
  opacity: 1;
  visibility: visible;
}

.coupon-panel {
  position: fixed;
  bottom: -600rpx;
  left: 0;
  right: 0;
  height: 600rpx;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  z-index: 999;
  transition: bottom 0.3s;
  display: flex;
  flex-direction: column;
}

.coupon-panel.show {
  bottom: 0;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.panel-close {
  font-size: 36rpx;
  color: #999;
}

.coupon-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #fff7e8 0%, #ffe8e8 100%);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.coupon-item.selected {
  border-color: #1989fa;
}

.coupon-item.disabled {
  opacity: 0.5;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.coupon-condition {
  font-size: 24rpx;
  color: #999;
}

.coupon-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
}
