.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  position: relative;
  padding: 40rpx 30rpx 80rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee0a24 100%);
  z-index: 0;
}

.countdown-section {
  position: relative;
  z-index: 1;
}

.countdown-title {
  display: flex;
  align-items: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.fire-icon {
  font-size: 48rpx;
  margin-right: 10rpx;
}

.countdown-timer {
  display: flex;
  align-items: center;
}

.timer-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 16rpx;
}

.timer-box {
  width: 56rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.timer-colon {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin: 0 8rpx;
}

.share-btn {
  position: absolute;
  top: 40rpx;
  right: 30rpx;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  font-size: 22rpx;
}

.share-btn text:first-child {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.rule-bar {
  display: flex;
  align-items: center;
  background: #fff5e6;
  margin: -40rpx 20rpx 20rpx;
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
  position: relative;
  z-index: 2;
}

.rule-icon {
  margin-right: 12rpx;
}

.rule-bar text:last-child {
  font-size: 24rpx;
  color: #ff976a;
}

.car-list {
  padding: 0 20rpx;
}

.car-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.car-item.sold-out {
  opacity: 0.7;
}

.car-image-wrapper {
  position: relative;
  width: 240rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.car-image {
  width: 100%;
  height: 100%;
}

.discount-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee0a24 100%);
  color: #fff;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.status-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}

.status-badge.status-1 {
  background: #07c160;
  color: #fff;
}

.status-badge.status-2 {
  background: #ff976a;
  color: #fff;
}

.status-badge.status-3 {
  background: #999;
  color: #fff;
}

.car-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.car-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.car-tags {
  display: flex;
  margin-bottom: 12rpx;
}

.tag {
  padding: 2rpx 12rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-right: 8rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.price-info {
  display: flex;
  align-items: baseline;
}

.sale-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.price-unit {
  font-size: 20rpx;
  color: #999;
  margin-left: 4rpx;
}

.stock-info {
  font-size: 22rpx;
  color: #ff976a;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: auto;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6b6b 0%, #ee0a24 100%);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.grab-btn {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee0a24 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1.2;
}

.grab-btn::after {
  border: none;
}

.grab-btn.disabled {
  background: #ccc;
}

.more-tip {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #999;
}
