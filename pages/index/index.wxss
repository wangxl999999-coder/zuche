.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 30rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
}

.search-input .iconfont {
  font-size: 32rpx;
  color: #999;
  margin-right: 10rpx;
}

.search-input .placeholder {
  font-size: 28rpx;
  color: #999;
}

.promotion-badge {
  margin-left: 20rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee0a24 100%);
  color: #fff;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.quick-entrance {
  display: flex;
  background: #fff;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.entrance-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entrance-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
  background: #f5f5f5;
}

.entrance-text {
  font-size: 24rpx;
  color: #666;
}

.map-container {
  width: 100%;
  height: 60vh;
}

.map {
  width: 100%;
  height: 100%;
}

.view-toggle {
  position: absolute;
  top: 200rpx;
  right: 30rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  font-size: 26rpx;
  color: #333;
}

.view-toggle text:first-child {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.car-list {
  padding: 20rpx;
}

.loading {
  padding: 100rpx;
  text-align: center;
  color: #999;
}

.selected-car {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 200;
}

.selected-car .car-image {
  width: 180rpx;
  height: 130rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.selected-car .car-info {
  flex: 1;
  margin-left: 20rpx;
}

.selected-car .car-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.selected-car .car-specs {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.selected-car .car-price {
  display: flex;
  align-items: baseline;
}

.selected-car .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
}

.selected-car .price::before {
  content: '¥';
  font-size: 24rpx;
}

.selected-car .unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.selected-car .book-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}
