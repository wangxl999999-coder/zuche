<view class="page">
  <view class="header">
    <view class="user-section" wx:if="{{isLogin}}" bindtap="goEditProfile">
      <image class="avatar" src="{{userInfo.avatarUrl}}" wx:if="{{userInfo.avatarUrl}}"></image>
      <view class="avatar-placeholder" wx:else>
        <text>{{userInfo.nickName ? userInfo.nickName.charAt(0) : '用'}}</text>
      </view>
      <view class="user-info">
        <view class="nickname">{{userInfo.nickName || '用户'}}</view>
        <view class="user-tags">
          <text class="tag {{isAuth ? 'active' : ''}}">{{isAuth ? '已实名' : '未实名'}}</text>
          <text class="tag {{isDriverVerified ? 'active' : ''}}">{{isDriverVerified ? '已认证驾照' : '未认证驾照'}}</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="login-btn" wx:else bindtap="goLogin">
      <view class="avatar-placeholder">
        <text>👤</text>
      </view>
      <view class="login-text">点击登录</view>
    </view>

    <view class="quick-actions" wx:if="{{isLogin}}">
      <view class="action-item" bindtap="goPage" data-path="/pages/coupons/coupons">
        <text class="action-icon">🎫</text>
        <text class="action-text">卡券</text>
        <text class="action-count" wx:if="{{couponCount > 0}}">{{couponCount}}</text>
      </view>
      <view class="action-item" bindtap="goPage" data-path="/pages/orders/orders?tab=2">
        <text class="action-icon">🚗</text>
        <text class="action-text">待取车</text>
      </view>
      <view class="action-item" bindtap="callService">
        <text class="action-icon">📞</text>
        <text class="action-text">客服</text>
      </view>
    </view>
  </view>

  <view class="menu-container">
    <view class="menu-group" wx:for="{{menuItems}}" wx:key="group" wx:for-item="group">
      <view class="group-title">{{group.group}}</view>
      <view class="menu-list">
        <view 
          class="menu-item" 
          wx:for="{{group.items}}" 
          wx:key="name"
          wx:for-item="item"
          bindtap="goPage"
          data-path="{{item.path}}"
          data-needauth="{{item.needAuth}}"
        >
          <text class="menu-icon">{{item.icon}}</text>
          <text class="menu-name">{{item.name}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="logout-section" wx:if="{{isLogin}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <view class="app-info">
    <text>租车出行 v1.0.0</text>
  </view>
</view>
