.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.emergency-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee0a24 100%);
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.emergency-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.emergency-text {
  flex: 1;
}

.emergency-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 4rpx;
}

.emergency-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.emergency-phone {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.required {
  color: #ee0a24;
  font-size: 24rpx;
}

.empty-order {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 60rpx;
  border-radius: 16rpx;
  text-align: center;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.order-list {
  padding: 0;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.order-item:last-child {
  margin-bottom: 0;
}

.order-item.selected {
  border-color: #1989fa;
  background: #e8f3ff;
}

.order-radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.order-item.selected .order-radio {
  border-color: #1989fa;
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  background: #1989fa;
  border-radius: 50%;
}

.car-image {
  width: 120rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.order-info {
  flex: 1;
}

.car-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.order-no {
  font-size: 22rpx;
  color: #999;
}

.types-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  padding: 16rpx 28rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.type-item.selected {
  background: #e8f3ff;
  color: #1989fa;
  border-color: #1989fa;
}

.desc-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.desc-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.images-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ee0a24;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.image-upload {
  width: 160rpx;
  height: 160rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.upload-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #999;
}

.phone-input {
  height: 88rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.emergency-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.switch-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.switch-icon {
  margin-right: 12rpx;
}

.switch {
  width: 90rpx;
  height: 50rpx;
  background: #ccc;
  border-radius: 25rpx;
  position: relative;
  transition: all 0.3s;
}

.switch.on {
  background: #07c160;
}

.switch-dot {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  transition: all 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.switch.on .switch-dot {
  left: 45rpx;
}

.tip-text {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn.disabled {
  background: #ccc;
}
