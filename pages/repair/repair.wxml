<view class="page">
  <view class="emergency-banner" bindtap="callEmergency">
    <text class="emergency-icon">🚨</text>
    <view class="emergency-text">
      <text class="emergency-title">紧急救援</text>
      <text class="emergency-desc">如遇紧急情况，请立即拨打救援电话</text>
    </view>
    <text class="emergency-phone">400-888-8888</text>
  </view>

  <view class="section" wx:if="{{orders.length > 0}}">
    <view class="section-title">选择订单 <text class="required">*</text></view>
    <view class="order-list">
      <view 
        class="order-item {{selectedOrder && selectedOrder.id === item.id ? 'selected' : ''}}"
        wx:for="{{orders}}"
        wx:key="id"
        bindtap="selectOrder"
        data-id="{{item.id}}"
      >
        <view class="order-radio">
          <view class="radio-inner" wx:if="{{selectedOrder && selectedOrder.id === item.id}}"></view>
        </view>
        <image class="car-image" src="{{item.carImage}}"></image>
        <view class="order-info">
          <view class="car-name">{{item.carName}}</view>
          <view class="order-no">订单号：{{item.orderNo}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-order" wx:else>
    <text class="empty-icon">🚗</text>
    <text class="empty-text">暂无进行中的订单</text>
  </view>

  <view class="section">
    <view class="section-title">故障类型 <text class="required">*</text></view>
    <view class="types-list">
      <view 
        class="type-item {{item.selected ? 'selected' : ''}}"
        wx:for="{{faultTypes}}"
        wx:key="id"
        bindtap="toggleFaultType"
        data-index="{{index}}"
      >
        {{item.name}}
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">故障描述 <text class="required">*</text></view>
    <textarea 
      class="desc-input" 
      placeholder="请详细描述故障情况，如故障发生时间、地点、具体现象等..."
      value="{{description}}"
      bindinput="onDescInput"
      maxlength="500"
      show-confirm-bar="{{false}}"
    ></textarea>
    <view class="desc-count">{{description.length}}/500</view>
  </view>

  <view class="section">
    <view class="section-title">上传照片（选填）</view>
    <view class="images-list">
      <view 
        class="image-item"
        wx:for="{{images}}"
        wx:key="index"
      >
        <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}"></image>
        <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">✕</view>
      </view>
      <view class="image-upload" bindtap="uploadImage" wx:if="{{images.length < 9}}">
        <text class="upload-icon">📷</text>
        <text class="upload-text">{{images.length}}/9</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">联系方式 <text class="required">*</text></view>
    <input 
      class="phone-input" 
      type="number"
      placeholder="请输入联系电话"
      value="{{contactPhone}}"
      bindinput="onPhoneInput"
      maxlength="11"
    />
  </view>

  <view class="emergency-switch" bindtap="toggleEmergency">
    <view class="switch-label">
      <text class="switch-icon">⚠️</text>
      <text>紧急报修</text>
    </view>
    <view class="switch {{emergency ? 'on' : ''}}">
      <view class="switch-dot"></view>
    </view>
  </view>

  <view class="tip-text">
    提示：紧急报修将优先安排处理，客服将在5分钟内联系您
  </view>

  <view class="bottom-bar">
    <button 
      class="submit-btn {{submitting ? 'disabled' : ''}}" 
      bindtap="submitRepair"
      disabled="{{submitting}}"
    >
      {{submitting ? '提交中...' : '提交报修'}}
    </button>
  </view>
</view>
