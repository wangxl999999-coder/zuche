.page {
  padding-bottom: 140rpx;
  background: #f5f5f5;
}

.status-header {
  padding: 60rpx 30rpx;
  color: #fff;
}

.status-label {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.status-tip {
  font-size: 26rpx;
  opacity: 0.9;
}

.progress-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.step-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #ddd;
  margin-bottom: 10rpx;
}

.step-item.active .step-dot {
  background: #1989fa;
}

.step-text {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.step-item.active .step-text {
  color: #1989fa;
}

.car-section {
  display: flex;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.car-image {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.car-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.car-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.car-specs {
  font-size: 24rpx;
  color: #999;
}

.car-price {
  display: flex;
  align-items: baseline;
}

.car-price .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
}

.car-price .price::before {
  content: '¥';
  font-size: 24rpx;
}

.car-price .unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.info-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  max-width: 400rpx;
  text-align: right;
}

.service-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.service-name {
  font-size: 26rpx;
  color: #333;
}

.service-price {
  font-size: 26rpx;
  color: #ee0a24;
}

.control-section {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 30rpx;
}

.password-area {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 8rpx;
}

.password-label {
  font-size: 28rpx;
  color: #666;
}

.password-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1989fa;
  letter-spacing: 8rpx;
}

.toggle-icon {
  font-size: 32rpx;
}

.control-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.control-btn::after {
  border: none;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.fee-label {
  font-size: 26rpx;
  color: #666;
}

.fee-value {
  font-size: 26rpx;
  color: #333;
}

.fee-value.discount {
  color: #07c160;
}

.fee-row.total {
  padding-top: 20rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid #f5f5f5;
}

.fee-row.total .fee-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.fee-row.total .fee-value {
  font-size: 32rpx;
  color: #ee0a24;
  font-weight: bold;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.bar-actions {
  margin-right: 20rpx;
}

.action-btn {
  padding: 16rpx 30rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: none;
}

.action-btn::after {
  border: none;
}

.bar-buttons {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.btn {
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: none;
  margin-left: 20rpx;
}

.btn::after {
  border: none;
}

.btn-outline {
  background: #fff;
  color: #1989fa;
  border: 2rpx solid #1989fa;
}

.btn-primary {
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
}
