<view class="page">
  <view class="header">
    <view class="header-bg"></view>
    <view class="invite-banner">
      <text class="banner-title">邀请好友</text>
      <text class="banner-subtitle">双方都得好礼</text>
    </view>
    
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{inviteCount}}</text>
        <text class="stat-label">已邀请好友</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">¥{{rewardAmount}}</text>
        <text class="stat-label">累计获得奖励</text>
      </view>
    </view>
  </view>

  <view class="invite-code-section">
    <view class="section-title">我的邀请码</view>
    <view class="code-wrapper">
      <text class="invite-code">{{inviteCode}}</text>
      <button class="copy-btn" bindtap="copyInviteCode">复制</button>
    </view>
  </view>

  <view class="share-section">
    <view class="section-title">立即邀请</view>
    <view class="share-buttons">
      <view class="share-btn" bindtap="shareToFriend">
        <text class="share-icon">💬</text>
        <text class="share-text">微信好友</text>
      </view>
      <view class="share-btn" bindtap="sharePoster">
        <text class="share-icon">🖼️</text>
        <text class="share-text">生成海报</text>
      </view>
      <view class="share-btn" open-type="share">
        <text class="share-icon">⭕</text>
        <text class="share-text">朋友圈</text>
      </view>
    </view>
  </view>

  <view class="reward-section">
    <view class="section-header">
      <text class="section-title">我的奖励</text>
      <text class="more-link" bindtap="goCoupons">查看全部 ›</text>
    </view>
    <scroll-view class="reward-scroll" scroll-x="true" show-scrollbar="{{false}}">
      <view class="reward-list">
        <view 
          class="reward-item {{item.status !== 1 ? 'disabled' : ''}}"
          wx:for="{{myRewards}}"
          wx:key="id"
        >
          <view class="reward-value">¥{{item.value}}</view>
          <view class="reward-name">{{item.name}}</view>
          <view class="reward-expire">{{item.expireTime}}到期</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="records-section">
    <view class="section-title">邀请记录</view>
    <view class="records-list">
      <view class="record-item" wx:for="{{inviteRecords}}" wx:key="id">
        <view class="record-avatar">
          <text>{{item.name.charAt(0)}}</text>
        </view>
        <view class="record-info">
          <view class="record-name">{{item.name}}</view>
          <view class="record-time">{{item.time}}</view>
        </view>
        <view class="record-reward">+¥{{item.reward}}</view>
      </view>
    </view>
  </view>

  <view class="rules-section">
    <view class="section-title">活动规则</view>
    <view class="rules-list">
      <view class="rule-item" wx:for="{{rules}}" wx:key="index">
        <text class="rule-index">{{index + 1}}.</text>
        <text class="rule-text">{{item}}</text>
      </view>
    </view>
  </view>
</view>
