.page {
  padding-bottom: 140rpx;
  background: #f5f5f5;
}

.image-swiper {
  width: 100%;
  height: 500rpx;
  background: #000;
}

.image-swiper image {
  width: 100%;
  height: 100%;
}

.image-counter {
  position: absolute;
  top: 460rpx;
  right: 30rpx;
  padding: 8rpx 20rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.car-info-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.car-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.car-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.car-tags {
  display: flex;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  margin-left: 10rpx;
}

.tag-success {
  background: #e8f7ef;
  color: #07c160;
}

.tag-primary {
  background: #e8f3ff;
  color: #1989fa;
}

.tag-warning {
  background: #fff7e8;
  color: #ff976a;
}

.car-specs {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.car-specs .dot {
  margin: 0 12rpx;
}

.car-features {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.feature {
  padding: 6rpx 16rpx;
  background: #f5f5f5;
  border-radius: 4rpx;
  font-size: 22rpx;
  color: #666;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.car-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.car-price {
  display: flex;
  align-items: baseline;
}

.car-price .price {
  font-size: 48rpx;
  font-weight: bold;
  color: #ee0a24;
}

.car-price .price::before {
  content: '¥';
  font-size: 28rpx;
}

.car-price .unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

.car-rating {
  display: flex;
  align-items: center;
}

.rating-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.location-section {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.location-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.location-info {
  flex: 1;
}

.location-address {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.location-hint {
  font-size: 24rpx;
  color: #1989fa;
}

.location-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1989fa;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #1989fa;
  border-radius: 2rpx;
}

.tab-content {
  background: #fff;
  padding: 30rpx;
}

.config-section {
  margin-bottom: 40rpx;
}

.config-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.config-grid {
  display: flex;
  flex-wrap: wrap;
}

.config-item {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  box-sizing: border-box;
  padding-right: 20rpx;
}

.config-label {
  font-size: 26rpx;
  color: #999;
}

.config-value {
  font-size: 26rpx;
  color: #333;
}

.review-summary {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #fafafa;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.summary-score {
  font-size: 64rpx;
  font-weight: bold;
  color: #ff976a;
  margin-right: 30rpx;
}

.summary-info {
  flex: 1;
}

.summary-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.review-list {
  padding: 0;
}

.review-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.review-user {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.review-time {
  font-size: 24rpx;
  color: #999;
}

.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
}

.review-tag {
  padding: 6rpx 16rpx;
  background: #e8f3ff;
  color: #1989fa;
  border-radius: 4rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.rule-section,
.fee-section {
  margin-bottom: 40rpx;
}

.rule-title,
.fee-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.rule-list {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
}

.rule-item {
  display: flex;
  padding: 16rpx 0;
  line-height: 1.6;
}

.rule-index {
  font-size: 26rpx;
  color: #1989fa;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 26rpx;
  color: #666;
}

.fee-list {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 10rpx 30rpx;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}

.fee-item:last-child {
  border-bottom: none;
}

.fee-label {
  font-size: 28rpx;
  color: #666;
}

.fee-value {
  font-size: 28rpx;
  color: #333;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.bar-left {
  display: flex;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.bar-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.bar-text {
  font-size: 22rpx;
  color: #666;
}

.bar-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.bar-price {
  display: flex;
  align-items: baseline;
  margin-right: 30rpx;
}

.bar-price .price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ee0a24;
}

.bar-price .price::before {
  content: '¥';
  font-size: 24rpx;
}

.bar-price .unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.book-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.book-btn::after {
  border: none;
}

.share-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.share-mask.show {
  opacity: 1;
  visibility: visible;
}

.share-panel {
  position: fixed;
  bottom: -300rpx;
  left: 0;
  right: 0;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 40rpx;
  z-index: 999;
  transition: bottom 0.3s;
}

.share-panel.show {
  bottom: 0;
}

.share-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 40rpx;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 30rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  border: none;
  margin-bottom: 20rpx;
}

.share-btn::after {
  border: none;
}

.share-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.cancel-btn {
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
  color: #666;
}
