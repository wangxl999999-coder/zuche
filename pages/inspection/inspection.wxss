.page {
  padding-bottom: 160rpx;
  background: #f5f5f5;
}

.tip-card {
  display: flex;
  background: #e8f3ff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 12rpx;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1989fa;
  margin-bottom: 8rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: #666;
}

.section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.required {
  color: #ee0a24;
  font-size: 24rpx;
}

.optional {
  color: #999;
  font-size: 24rpx;
}

.add-btn {
  font-size: 26rpx;
  color: #1989fa;
  font-weight: normal;
}

.inspection-item {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.inspection-item.active {
  border-color: #1989fa;
  background: #e8f3ff;
}

.inspection-item:last-child {
  margin-bottom: 0;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-status {
  font-size: 24rpx;
  color: #999;
}

.item-status.done {
  color: #07c160;
}

.item-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.image-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.image-item .delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ee0a24;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.upload-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #1989fa;
  text-align: center;
}

.status-form {
  padding: 0;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.form-input {
  height: 80rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.fuel-slider {
  width: 100%;
  margin: 10rpx 0;
}

.fuel-labels {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.damage-list {
  padding: 0;
}

.damage-item {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.damage-item:last-child {
  margin-bottom: 0;
}

.damage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.damage-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.damage-header .delete-btn {
  font-size: 24rpx;
  color: #ee0a24;
}

.damage-input {
  height: 80rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.damage-images {
  display: flex;
  gap: 10rpx;
}

.image-upload {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #999;
}

.image-upload image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.image-upload.add text:first-child {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.empty-damage {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}

.photo-actions {
  position: fixed;
  bottom: 140rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 50;
}

.photo-btn {
  width: 100%;
  height: 80rpx;
  background: #fff;
  color: #1989fa;
  border: 2rpx solid #1989fa;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-btn::after {
  border: none;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn.disabled {
  background: #ccc;
}
