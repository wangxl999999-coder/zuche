<view class="page">
  <view class="tip-card">
    <view class="tip-icon">📷</view>
    <view class="tip-text">
      <view class="tip-title">{{typeText}}验车须知</view>
      <view class="tip-desc">请仔细检查车辆状况，拍照留证，如有问题请标记。</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">验车项目 <text class="required">（必填）</text></view>
    <view class="inspection-list">
      <view 
        class="inspection-item {{currentItemId === item.id ? 'active' : ''}}"
        wx:for="{{inspectionItems}}"
        wx:key="id"
        bindtap="selectItem"
        data-id="{{item.id}}"
      >
        <view class="item-header">
          <view class="item-name">
            {{item.name}}
            <text class="required" wx:if="{{item.required}}">*</text>
          </view>
          <view class="item-status {{item.status === 1 ? 'done' : ''}}">
            {{item.status === 1 ? '已完成' : '待拍照'}}
          </view>
        </view>
        <view class="item-images" wx:if="{{item.images.length > 0}}">
          <view 
            class="image-item"
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:for-index="imgIndex"
            wx:key="imgIndex"
          >
            <image src="{{img}}" mode="aspectFill" bindtap="previewImage" data-item-id="{{item.id}}" data-index="{{imgIndex}}"></image>
            <view class="delete-btn" catchtap="deleteImage" data-item-id="{{item.id}}" data-index="{{imgIndex}}">✕</view>
          </view>
        </view>
        <view class="upload-tip" wx:if="{{currentItemId === item.id}}">
          点击下方按钮进行拍照
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">车辆状态</view>
    <view class="status-form">
      <view class="form-item">
        <view class="form-label">行驶里程（公里）</view>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="请输入当前里程"
          value="{{mileage}}"
          bindinput="onMileageInput"
        />
      </view>
      <view class="form-item">
        <view class="form-label">油量（{{fuelLevel}}%）</view>
        <slider 
          class="fuel-slider"
          value="{{fuelLevel}}"
          min="0"
          max="100"
          step="5"
          activeColor="#1989fa"
          bindchange="onFuelChange"
        />
        <view class="fuel-labels">
          <text>空</text>
          <text>满</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      损伤标记 <text class="optional">（选填）</text>
      <text class="add-btn" bindtap="addDamageMark">+ 添加</text>
    </view>
    <view class="damage-list" wx:if="{{damageMarks.length > 0}}">
      <view class="damage-item" wx:for="{{damageMarks}}" wx:key="id">
        <view class="damage-header">
          <text class="damage-title">损伤{{index + 1}}</text>
          <text class="delete-btn" bindtap="deleteDamageMark" data-index="{{index}}">删除</text>
        </view>
        <input 
          class="damage-input"
          placeholder="请描述损伤位置和情况"
          value="{{item.description}}"
          bindinput="onDamageDescInput"
          data-index="{{index}}"
        />
        <view class="damage-images">
          <view 
            class="image-upload"
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:for-index="imgIndex"
            wx:key="imgIndex"
          >
            <image src="{{img}}" mode="aspectFill"></image>
          </view>
          <view class="image-upload add" bindtap="uploadDamagePhoto" data-index="{{index}}" wx:if="{{item.images.length < 3}}">
            <text>📷</text>
            <text>添加照片</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-damage" wx:else>
      <text>暂无损伤标记，如有问题请添加</text>
    </view>
  </view>

  <view class="photo-actions">
    <button class="photo-btn" bindtap="takePhoto">
      📷 拍照上传
    </button>
  </view>

  <view class="bottom-bar">
    <button 
      class="submit-btn {{submitting ? 'disabled' : ''}}" 
      bindtap="submitInspection"
      disabled="{{submitting}}"
    >
      {{submitting ? '提交中...' : '提交' + typeText + '验车报告'}}
    </button>
  </view>
</view>
