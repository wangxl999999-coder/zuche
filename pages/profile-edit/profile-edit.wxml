<view class="page">
  <view class="avatar-section">
    <view class="avatar-label">头像</view>
    <view class="avatar-wrapper" bindtap="chooseAvatar">
      <image class="avatar" src="{{tempAvatar || userInfo.avatarUrl}}" wx:if="{{tempAvatar || userInfo.avatarUrl}}"></image>
      <view class="avatar-placeholder" wx:else>
        <text>{{nickname ? nickname.charAt(0) : '👤'}}</text>
      </view>
      <view class="camera-icon">📷</view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <view class="form-label">昵称</view>
      <input 
        class="form-input" 
        placeholder="请输入昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <view class="form-label">性别</view>
      <picker 
        mode="selector" 
        range="{{['保密', '男', '女']}}" 
        value="{{gender}}"
        bindchange="onGenderChange"
      >
        <view class="picker-value">
          {{['保密', '男', '女'][gender]}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">手机号</view>
      <input 
        class="form-input" 
        type="number"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <view class="form-item">
      <view class="form-label">邮箱</view>
      <input 
        class="form-input" 
        type="text"
        placeholder="请输入邮箱（选填）"
        value="{{email}}"
        bindinput="onEmailInput"
      />
    </view>
  </view>

  <view class="form-section">
    <view class="section-header">
      <text class="section-title">紧急联系人</text>
      <text class="section-desc">用于紧急情况联系</text>
    </view>

    <view class="form-item">
      <view class="form-label">联系人姓名</view>
      <input 
        class="form-input" 
        placeholder="请输入姓名（选填）"
        value="{{emergencyContact}}"
        bindinput="onEmergencyContactInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">联系电话</view>
      <input 
        class="form-input" 
        type="number"
        placeholder="请输入电话（选填）"
        value="{{emergencyPhone}}"
        bindinput="onEmergencyPhoneInput"
        maxlength="11"
      />
    </view>
  </view>

  <view class="bottom-bar">
    <button class="save-btn" bindtap="saveProfile">保存</button>
  </view>
</view>
