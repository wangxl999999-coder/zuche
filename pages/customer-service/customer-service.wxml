<view class="page">
  <view class="contact-section">
    <view class="section-title">联系我们</view>
    <view class="contact-item phone" bindtap="callPhone">
      <view class="contact-icon">📞</view>
      <view class="contact-info">
        <view class="contact-label">客服电话</view>
        <view class="contact-value">{{phone}}</view>
      </view>
      <view class="contact-action">拨打</view>
    </view>
    <view class="contact-item" bindtap="copyWechat">
      <view class="contact-icon">💬</view>
      <view class="contact-info">
        <view class="contact-label">微信客服</view>
        <view class="contact-value">{{wechat}}</view>
      </view>
      <view class="contact-action">复制</view>
    </view>
    <view class="work-time">
      <text>工作时间：{{workTime}}</text>
    </view>
  </view>

  <view class="quick-service">
    <view class="section-title">快捷服务</view>
    <view class="service-grid">
      <view class="service-item" bindtap="goRepair">
        <view class="service-icon">🔧</view>
        <view class="service-name">故障报修</view>
      </view>
      <view class="service-item">
        <view class="service-icon">❓</view>
        <view class="service-name">使用帮助</view>
      </view>
      <view class="service-item">
        <view class="service-icon">📝</view>
        <view class="service-name">意见反馈</view>
      </view>
      <view class="service-item">
        <view class="service-icon">💡</view>
        <view class="service-name">投诉建议</view>
      </view>
    </view>
  </view>

  <view class="faq-section">
    <view class="section-title">常见问题</view>
    <view class="faq-list">
      <view 
        class="faq-item {{item.expanded ? 'expanded' : ''}}"
        wx:for="{{faqs}}"
        wx:key="index"
        bindtap="toggleFaq"
        data-index="{{index}}"
      >
        <view class="faq-question">
          <text class="question-text">{{item.question}}</text>
          <text class="question-arrow">{{item.expanded ? '▲' : '▼'}}</text>
        </view>
        <view class="faq-answer">
          <text>{{item.answer}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
